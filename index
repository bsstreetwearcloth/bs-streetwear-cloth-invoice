<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BS Streetwear Cloth - Invoice</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#eee;font-family:Arial,Helvetica,sans-serif;color:#20252d}
  .page{width:min(210mm,100%);min-height:297mm;margin:20px auto;background:#fff;padding:18mm 14mm 14mm;box-shadow:0 2px 15px #bbb}
  .topline{height:4px;background:#45484d;margin-bottom:12px}
  .header{display:grid;grid-template-columns:105px 1fr 125px;gap:22px;align-items:start}
  .brandbox{height:78px;border:2px solid #444;border-radius:5px;display:flex;align-items:center;justify-content:center;text-align:center;font-weight:700;font-size:12px;line-height:1.1}
  h1{font-size:19px;margin:3px 0 8px}
  .company{font-size:9px;line-height:1.55;color:#666}
  .meta{font-size:10px}
  .meta b{display:block;font-size:9px;margin-bottom:4px}
  .meta .value{margin-bottom:14px;color:#555}
  hr{border:0;border-top:1px solid #ddd;margin:22px 0 12px}
  .label{font-size:9px;color:#777;margin-bottom:5px}
  .selectrow{font-size:13px;margin-bottom:16px}
  table{width:100%;border-collapse:collapse;font-size:10px}
  th{background:#4c4d4f;color:white;padding:7px 6px;text-align:left;font-size:8px}
  th:nth-child(n+3),td:nth-child(n+3){text-align:right}
  td{padding:7px 6px;border-bottom:1px solid #eee}
  .summary{margin:10px 0 18px auto;width:46%;font-size:10px}
  .sumrow{display:flex;justify-content:space-between;padding:7px 8px}
  .sumrow.total{font-weight:700}
  .sumrow.due{background:#f0f0f0;font-weight:700}
  .payment{border:1px solid #bbb;border-radius:6px;padding:12px 14px;margin-bottom:12px}
  .payment h3{text-align:center;font-size:10px;margin:0 0 12px}
  .banks{display:grid;grid-template-columns:1fr 1fr}
  .bank{padding:0 12px;font-size:9px;line-height:1.65}
  .bank+ .bank{border-left:1px solid #bbb}
  .bankname{font-weight:700;font-size:10px;margin-bottom:4px}
  .note{background:#f1f1f1;border-left:5px solid #4c4d4f;padding:9px 10px;font-size:8px;line-height:1.6;margin-bottom:14px}
  .note b{font-size:9px}
  .contacts{border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:9px 0;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;font-size:8px;align-items:center}
  .contact{display:flex;align-items:center;gap:7px}
  .icon{width:20px;height:20px;flex:none}
  .icon svg{width:20px;height:20px;fill:#111}
  .thanks{text-align:center;font-size:8px;color:#777;font-style:italic;margin-top:12px}
  .footer{display:flex;justify-content:space-between;color:#999;font-size:7px;margin-top:32px}
  @media print{
    body{background:#fff}
    .page{margin:0;box-shadow:none;width:210mm;min-height:297mm}
  }
  @media(max-width:650px){
    .page{padding:20px 14px}
    .header{grid-template-columns:76px minmax(0,1fr) 76px;gap:10px;align-items:start}
    .brandbox{height:65px;font-size:9px}
    h1{font-size:15px;white-space:nowrap}
    .company{font-size:7.5px;line-height:1.45}
    .meta{font-size:8px;text-align:left}
    .meta b{font-size:8px}
    .meta .value{margin-bottom:10px}
    hr{margin:18px 0 12px}
    .summary{width:60%}
    .payment{padding:12px 8px}
    .bank{padding:0 5px;font-size:8px}
    .bankname{font-size:8px}
    .contacts{font-size:7px}
    .contact{gap:4px}
    .icon,.icon svg{width:18px;height:18px}
  }

  @media print{
    html,body{background:#fff!important;margin:0!important;padding:0!important}
    .no-print{display:none!important}
    .page{
      margin:0!important;
      width:210mm!important;
      height:297mm!important;
      min-height:297mm!important;
      box-shadow:none!important;
      overflow:hidden!important;
    }
    @page{size:A4 portrait;margin:0}
  }
</style>

<style id="single-page-print-fix">
@media print {
  html, body {
    background: #fff !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .no-print {
    display: none !important;
  }
  .page {
    box-sizing: border-box !important;
    width: 190mm !important;
    height: 277mm !important;
    min-height: 277mm !important;
    max-height: 277mm !important;
    margin: 0 auto !important;
    padding: 9mm 10mm 14mm !important;
    box-shadow: none !important;
    overflow: hidden !important;
    page-break-after: avoid !important;
    break-after: avoid-page !important;
  }
  @page {
    size: A4 portrait;
    margin: 10mm;
  }
}
</style>


<style id="print-one-page-letter-fix">
@media print {
  @page { size: Letter portrait; margin: 0 !important; }
  html, body { width: 215.9mm !important; height: 279.4mm !important; margin: 0 !important; padding: 0 !important; }
  .page {
    box-sizing: border-box !important;
    width: 215.9mm !important;
    height: 279.4mm !important;
    min-height: 279.4mm !important;
    max-height: 279.4mm !important;
    margin: 0 !important;
    padding: 8mm 10mm 10mm !important;
    overflow: hidden !important;
    box-shadow: none !important;
  }
  #invoiceNav { display:none !important; }
  .footer { margin-top: 12px !important; }
}
</style>
</head>
<body>
<div class="page">
  <div class="topline"></div>

  <section class="header">
    <div class="brandbox">BS<br>STREETWEAR<br>CLOTH</div>
    <div>
      <h1>BS STREETWEAR CLOTH</h1>
      <div class="company">
        Jalan Jimbaran Telagapanas, Samban, Kabupaten Semarang, Jawa Tengah, Indonesia<br>
        WhatsApp: 85728122348<br>
        arghaniriawan@gmail.com
      </div>
    </div>
    <div class="meta">
      <b>FAKTUR</b><div class="value" id="invoiceNo">-</div>
      <b>TANGGAL</b><div class="value" id="invoiceDate">-</div>
    </div>
  </section>

  <hr>
  <div class="label">UNTUK</div>
  <div class="selectrow" style="display:flex;align-items:center;gap:10px;">
    <span aria-hidden="true" style="display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;border:1.5px solid #444;border-radius:6px;">
      <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="#222" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 8h12l1 12H5L6 8z"></path>
        <path d="M9 8a3 3 0 0 1 6 0"></path>
      </svg>
    </span>
    <span>Pilih pesanan untuk melihat invoice.</span>
  </div>

  <table>
    <thead>
      <tr>
        <th>DESKRIPSI</th><th>UKURAN</th><th>HARGA SATUAN</th><th>QTY</th><th>TOTAL</th>
      </tr>
    </thead>
    <tbody id="items">
      <tr><td colspan="5" style="text-align:center;color:#999;padding:18px">Belum ada pesanan</td></tr>
    </tbody>
  </table>

  <div class="summary">
    <div class="sumrow total"><span>TOTAL</span><span id="total">Rp0</span></div>
    <div class="sumrow"><span>DP / PEMBAYARAN</span><span id="dp">Rp0</span></div>
    <div class="sumrow due"><span>TOTAL KEKURANGAN</span><span id="due">Rp0</span></div>
  </div>

  <section class="payment">
    <h3>METODE PEMBAYARAN</h3>
    <div class="banks">
      <div class="bank">
        <div class="bankname" style="display:flex;align-items:center;gap:10px;">
      <img src="https://www.bca.co.id/-/media/Feature/Card/List-Card/Tentang-BCA/Brand-Assets/Logo-BCA/Logo-BCA_Biru.png"
           alt="Logo BCA" style="width:92px;height:auto;object-fit:contain;">
      <span>Bank Central Asia (BCA)</span>
    </div>
        Nama Rekening: Randirawan<br>
        No Rek: 3201-1621-39
      </div>
      <div class="bank">
        <div class="bankname" style="display:flex;align-items:center;gap:10px;">
      <img src="https://upload.wikimedia.org/wikipedia/commons/a/ad/Bank_Mandiri_logo_2016.svg"
           alt="Logo Bank Mandiri" style="width:105px;height:auto;object-fit:contain;">
      <span>Bank Mandiri</span>
    </div>
        Nama Rekening: Randirawan<br>
        No Rek: 136-00-1927498-1
      </div>
    </div>
  </section>

  <div class="note">
    <b>CATATAN PESANAN</b><br>
    • Pesanan diproses setelah pembayaran/DP diterima.<br>
    • Pelunasan dilakukan sebelum pengambilan/pengiriman.
  </div>

  <div class="contacts">
    <div class="contact">
      <span class="icon">
        <svg viewBox="0 0 24 24" aria-label="Instagram"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A4.5 4.5 0 1 1 12 16.5 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 12 14.5 2.5 2.5 0 0 0 12 9.5zM17.7 6.3a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"/></svg>
      </span>
      <span>@bsstreetwear_cloth</span>
    </div>
    <div class="contact">
      <span class="icon">
        <svg viewBox="0 0 24 24" aria-label="TikTok"><path d="M14 3h3.1c.3 1.7 1.3 3.1 2.9 4v3.1c-1.4-.1-2.7-.5-3.9-1.2v6.2A5.9 5.9 0 1 1 10.2 9v3.2a2.8 2.8 0 1 0 2.8 2.8V3H14z"/></svg>
      </span>
      <span>BS Streetwear Cloth</span>
    </div>
    <div class="contact">
      <span class="icon">
        <svg viewBox="0 0 24 24" aria-label="Google Maps"><path d="M12 2a7 7 0 0 0-7 7c0 5.1 7 13 7 13s7-7.9 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
      </span>
      <span>Semarang, Jawa Tengah</span>
    </div>
  </div>

  <div class="thanks">Terima kasih telah mempercayakan pesanan Anda kepada BS Streetwear Cloth.</div>

  <div id="invoiceNav" class="no-print" style="display:flex;gap:10px;justify-content:center;margin:22px 0 4px;flex-wrap:wrap;">
    <button type="button" onclick="goOrders()"
      style="border:0;border-radius:7px;background:#222;color:#fff;padding:10px 18px;font-size:10px;font-weight:700;cursor:pointer;">
      🛒 BELI / BUAT PESANAN
    </button>
    <button type="button" onclick="goHome()"
      style="border:1px solid #222;border-radius:7px;background:#fff;color:#222;padding:10px 18px;font-size:10px;font-weight:700;cursor:pointer;">
      🏠 KEMBALI KE MENU AWAL
    </button>
  </div>

  <div class="footer">
    <span>BS Streetwear Cloth — Invoice</span>
    <span id="pageDate">Halaman 1</span>
  </div>
</div>

<script>
const DATA_KEY='bsStreetwearDataV2';

function rupiah(n){
  return 'Rp'+Number(n||0).toLocaleString('id-ID');
}
function loadStoreData(){
  try{
    const d=JSON.parse(localStorage.getItem(DATA_KEY)||'null');
    if(!d) return;
    const s=d.settings||{};
    const orders=Array.isArray(d.orders)?d.orders:[];
    const o=orders[orders.length-1];

    if(s.name) document.querySelector('h1').textContent=s.name;
    const company=document.querySelector('.company');
    if(company){
      company.innerHTML=
        (s.address||'Jalan Jimbaran Telagapanas, Samban, Kabupaten Semarang, Jawa Tengah, Indonesia')+
        '<br>WhatsApp: '+(s.phone||'85728122348')+
        '<br>'+(s.email||'arghaniriawan@gmail.com');
    }

    if(o){
      const meta=document.querySelectorAll('.meta .value');
      if(meta[0]) meta[0].textContent=o.id||'-';
      if(meta[1]) meta[1].textContent=o.date||'-';

      const customer=document.querySelector('.selectrow span:last-child');
      if(customer) customer.textContent=o.customer ? o.customer : 'Pilih pesanan untuk melihat invoice.';

      const tbody=document.querySelector('#items');
      if(tbody){
        tbody.innerHTML='<tr>'+
          '<td>'+esc(o.product||'T-SHIRT')+'</td>'+
          '<td style="text-align:right">'+rupiah(o.price)+'</td>'+
          '<td style="text-align:right">'+(o.qty||1)+'</td>'+
          '<td style="text-align:right">'+rupiah(o.total)+'</td>'+
        '</tr>';
      }
      const rows=document.querySelectorAll('.sumrow span');
      if(rows[1]) rows[1].textContent=rupiah(o.total);
      if(rows[3]) rows[3].textContent=rupiah(o.dp);
      if(rows[5]) rows[5].textContent=rupiah(Math.max(0,(o.total||0)-(o.dp||0)));
    }

    if(s.bcaName){
      const b=document.querySelectorAll('.bank');
      if(b[0]){
        b[0].querySelector('.bankname').innerHTML=
          '<img src="https://www.bca.co.id/-/media/Feature/Card/List-Card/Tentang-BCA/Brand-Assets/Logo-BCA/Logo-BCA_Biru.png" alt="Logo BCA" style="width:92px;height:auto;object-fit:contain;vertical-align:middle;margin-right:8px;">'+
          '<span>Bank Central Asia (BCA)</span>';
        b[0].innerHTML=b[0].querySelector('.bankname').outerHTML+
          '<div>Nama Rekening: '+esc(s.bcaName)+'</div><div>No Rek: '+esc(s.bcaNo||'3201-1621-39')+'</div>';
      }
    }
    if(s.mandiriName){
      const b=document.querySelectorAll('.bank');
      if(b[1]){
        b[1].querySelector('.bankname').innerHTML=
          '<img src="https://upload.wikimedia.org/wikipedia/commons/a/ad/Bank_Mandiri_logo_2016.svg" alt="Logo Bank Mandiri" style="width:105px;height:auto;object-fit:contain;vertical-align:middle;margin-right:8px;">'+
          '<span>Bank Mandiri</span>';
        b[1].innerHTML=b[1].querySelector('.bankname').outerHTML+
          '<div>Nama Rekening: '+esc(s.mandiriName)+'</div><div>No Rek: '+esc(s.mandiriNo||'136-00-1927498-1')+'</div>';
      }
    }
  }catch(e){}
}
function esc(v){
  return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}
function goOrders(){
  window.location.href='index_fixed.html#orders';
}
function goHome(){
  window.location.href='index_fixed.html';
}
window.addEventListener('DOMContentLoaded',loadStoreData);
</script>

</body>
</html>
